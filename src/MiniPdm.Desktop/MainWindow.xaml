<Window x:Class="MiniPdm.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MiniPdm.Desktop"
        Title="Мини-PDM · Состав изделия" Width="1340" Height="850" MinWidth="1000" MinHeight="640" Background="#F1F5F9" FontFamily="Segoe UI" FontSize="13">
  <DockPanel Margin="20" Background="#F1F5F9">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Мини-PDM" FontSize="27" FontWeight="SemiBold" Foreground="#0F172A"/>
      <TextBlock Text="Конструкторский состав • версии • спецификации" Foreground="#64748B" Margin="0,4,0,18"/>
      <WrapPanel Margin="0,0,0,12">
        <Button Content="Импорт папки…" Command="{Binding ImportCommand}" Background="#2563EB" Foreground="White"/>
        <Button Content="Обновить" Command="{Binding RefreshCommand}"/>
        <Button Content="Рассчитать состав" Command="{Binding CalculateCommand}"/>
        <Button Content="Экспорт CSV…" Command="{Binding ExportCommand}"/>
        <Button Content="Отменить импорт" Command="{Binding CancelImportCommand}"/>
      </WrapPanel>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#E2E8F0" Padding="10" Margin="0,12,0,0">
      <StackPanel>
        <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" Padding="12" IsEnabled="{Binding IsIdle}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
          <TextBlock Text="КАТАЛОГ ОБЪЕКТОВ" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBox Grid.Row="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по обозначению или наименованию" Margin="0,0,0,8"/>
          <ListBox Grid.Row="2" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedCatalogObject}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="3"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Designation}" FontSize="11" Foreground="#64748B"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="3" Text="ДЕРЕВО ВЫБРАННОГО ИЗДЕЛИЯ" FontWeight="SemiBold" Margin="0,14,0,8"/>
          <TreeView Grid.Row="4" ItemsSource="{Binding Roots}">
            <TreeView.Resources><HierarchicalDataTemplate DataType="{x:Type local:TreeNodeViewModel}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Caption}" ToolTip="{Binding Caption}"/></HierarchicalDataTemplate></TreeView.Resources>
            <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="True"/><Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/></Style></TreeView.ItemContainerStyle>
          </TreeView>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="White" Padding="18" IsEnabled="{Binding IsIdle}">
          <StackPanel>
            <TextBlock Text="{Binding SelectedObject.Name, TargetNullValue=Выберите объект}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedObject.Designation}" Foreground="#64748B" Margin="0,4,0,8"/>
            <UniformGrid Columns="3">
              <StackPanel><TextBlock Text="Тип" Style="{StaticResource Label}"/><TextBlock Text="{Binding SelectedObject.TypeText}"/></StackPanel>
              <StackPanel><TextBlock Text="Текущая версия" Style="{StaticResource Label}"/><TextBlock Text="{Binding SelectedObject.VersionNumber, TargetNullValue=—}"/></StackPanel>
              <StackPanel><TextBlock Text="Состояние" Style="{StaticResource Label}"/><TextBlock Text="{Binding SelectedObject.StateText}"/></StackPanel>
              <StackPanel><TextBlock Text="Материал" Style="{StaticResource Label}"/><TextBlock Text="{Binding SelectedObject.Material, TargetNullValue=—}"/></StackPanel>
              <StackPanel><TextBlock Text="Масса единицы, кг" Style="{StaticResource Label}"/><TextBlock Text="{Binding SelectedObject.MassKg, TargetNullValue=—}"/></StackPanel>
            </UniformGrid>
            <WrapPanel Margin="0,16,0,0"><Button Content="Утвердить" Command="{Binding ApproveCommand}"/><Button Content="Аннулировать версию" Command="{Binding CancelVersionCommand}"/></WrapPanel>
            <TextBlock Text="{Binding MassResult}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#1D4ED8"/>
          </StackPanel>
        </Border>
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTab}">
          <TabItem Header="Состав первого уровня">
            <DataGrid ItemsSource="{Binding DirectChildren}"><DataGrid.Columns><DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="155"/><DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="60"/><DataGridTextColumn Header="Масса, кг" Binding="{Binding MassKg}" Width="85"/></DataGrid.Columns></DataGrid>
          </TabItem>
          <TabItem Header="Сводная спецификация">
            <DataGrid ItemsSource="{Binding Specification}"><DataGrid.Columns><DataGridTextColumn Header="Обозначение" Binding="{Binding Designation}" Width="155"/><DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="60"/><DataGridTextColumn Header="За 1 шт., кг" Binding="{Binding UnitMassKg}" Width="85"/><DataGridTextColumn Header="Всего, кг" Binding="{Binding TotalMassKg}" Width="85"/></DataGrid.Columns></DataGrid>
          </TabItem>
          <TabItem Header="Отчёт импорта">
            <DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding ImportSummary}" Margin="10" FontWeight="SemiBold"/>
              <DataGrid ItemsSource="{Binding ImportRows}" RowHeight="NaN"><DataGrid.Columns><DataGridTextColumn Header="Файл" Binding="{Binding FileName}" Width="220"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Результат" Binding="{Binding Result}" Width="110"/><DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="100"/><DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="30"/><Style.Triggers><DataTrigger Binding="{Binding Result}" Value="Ошибка"><Setter Property="Background" Value="#FFF1F2"/><Setter Property="Foreground" Value="#9F1239"/></DataTrigger><DataTrigger Binding="{Binding Result}" Value="Предупреждение"><Setter Property="Background" Value="#FFFBEB"/><Setter Property="Foreground" Value="#92400E"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle></DataGrid>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
